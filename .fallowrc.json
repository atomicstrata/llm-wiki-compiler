{
  "$schema": "https://fallow.tools/schema.json",
  "entry": [
    "src/viewer/assets/viewer.js",
    "scripts/copy-viewer-assets.mjs"
  ],
  "ignorePatterns": [
    "docs/**",
    "src/viewer/assets/index.html",
    "src/viewer/assets/viewer.css"
  ],
  "ignoreExports": [
    { "file": "src/utils/output.ts", "exports": ["getQuiet"] },
    { "file": "src/utils/constants.ts", "exports": ["PROFILE_FILE", "ADAPTATION_DIR"] },
    { "file": "src/profile/types.ts", "exports": ["LoadedProfile", "EntityPageRef"] }
  ],
  "overrides": [
    {
      "files": ["src/providers/*.ts", "src/utils/provider-guard.ts"],
      "rules": {
        "unused-class-members": "off"
      }
    }
  ]
}
