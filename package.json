{
  "name": "llm-wiki-compiler",
  "version": "1.5.0",
  "description": "Compile documents into a persistent, cited knowledge wiki for AI agents. CLI, MCP server, and TypeScript SDK.",
  "mcpName": "io.github.atomicstrata/llmwiki",
  "type": "module",
  "workspaces": ["packages/llmwiki-core", "packages/llmwiki-local-workflows"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "llmwiki": "dist/cli.js"
  },
  "scripts": {
    "build": "bun run typecheck:viewer-v2 && tsup",
    "typecheck:viewer-v2": "bun check -p viewer-v2",
    "dev:view-v2": "vite --config viewer-v2/vite.config.ts",
    "dev": "tsup --watch src --watch scripts --watch tsconfig.json --watch \"packages/*/package.json\" --watch \"packages/*/tsup.config.ts\"",
    "benchmark:review": "bun scripts/benchmark-review-batch.mjs",
    "dev:view": "bun scripts/dev-viewer.mjs",
    "vendor:fonts": "bun scripts/vendor-fonts.mjs",
    "mcp:manifest": "bun scripts/mcp-manifest.mjs",
    "release:check-docs": "bun scripts/check-release-docs.mjs",
    "release:check-docs:current": "bun scripts/check-release-docs.mjs --current-version",
    "test": "bun run build && bun scripts/run-tests.mjs",
    "test:watch": "bun test --watch",
    "test:profile": "bun run build && bun scripts/test-profile.ts",
    "test:timings": "bun run build && bun scripts/run-tests.mjs --timings=test-timings.json --update-timings",
    "typecheck:tests": "bun scripts/typecheck-tests.ts",
    "typecheck:tests:update": "bun scripts/typecheck-tests.ts --update",
    "fallow:ci": "bash scripts/fallow-ci.sh",
    "prepublishOnly": "bun run release:check-docs:current && bun run build && bun pm pack --dry-run --ignore-scripts",
    "prepare": "husky",
    "test:pack": "bun test --path-ignore-patterns='**/dist/**' ./test/sdk/packaging.test.ts ./test/products/private-packages-pack.test.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "ai-agents",
    "knowledge-base",
    "retrieval",
    "agent-skills",
    "knowledge",
    "wiki",
    "llm",
    "compiler",
    "markdown",
    "obsidian"
  ],
  "license": "MIT",
  "author": "Ethan Joffe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atomicstrata/llm-wiki-compiler.git"
  },
  "homepage": "https://github.com/atomicstrata/llm-wiki-compiler#readme",
  "bugs": {
    "url": "https://github.com/atomicstrata/llm-wiki-compiler/issues"
  },
  "files": [
    "dist/",
    "!dist/tsconfig.json",
    "skills/llmwiki/",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@anthropic-ai/sdk": "^0.101.0",
    "@atomicstrata/llmwiki-core": "1.5.0",
    "@atomicstrata/llmwiki-local-workflows": "1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.20.0",
    "canonicalize": "^3.0.0",
    "chokidar": "^6.0.0",
    "commander": "^13.0.0",
    "dotenv": "^18.0.10",
    "js-yaml": "^4.3.2",
    "jsdom": "^25.0.0",
    "markdown-it": "^14.3.3",
    "openai": "^6.49.0",
    "p-limit": "^7.3.3",
    "pdf-parse": "^2.4.5",
    "sanitize-html": "^2.18.1",
    "turndown": "^7.2.5",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1166.0",
    "@copilotkit/aimock": "^1.48.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/dm-sans": "5.2.6",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "5.2.7",
    "@fontsource/space-grotesk": "^5.3.0",
    "@smithy/node-http-handler": "^4.14.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "d3": "^7.9.2",
    "esbuild": "0.28.1",
    "fallow": "2.82.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  },
  "peerDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1149.0",
    "@smithy/node-http-handler": "^4.12.1"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-bedrock-runtime": {
      "optional": true
    },
    "@smithy/node-http-handler": {
      "optional": true
    }
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
